{
	"name": "the-slidereact",
	"version": "1.0.1",
	"description": "Lightweight TypeScript React 19+ slider with responsive breakpoints, infinite mode, pointer gestures and SSR support",
	"license": "MIT",
	"author": "D. Volkov",
	"homepage": "https://github.com/meowd/slidereact#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/meowd/slidereact.git"
	},
	"bugs": {
		"url": "https://github.com/meowd/slidereact/issues"
	},
	"keywords": [
		"react",
		"slider",
		"carousel",
		"typescript",
		"swipe",
		"responsive",
		"ssr"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.14.0"
	},
	"peerDependencies": {
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
		"build": "npm run clean && tsup",
		"typecheck": "tsc --noEmit",
		"demo": "vite --config demo/vite.config.ts",
		"demo:build": "vite build --config demo/vite.config.ts",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tsup": "^8.5.0",
		"typescript": "^5.9.0",
		"vite": "^7.0.0",
		"@types/node": "^24.0.0"
	}
}
